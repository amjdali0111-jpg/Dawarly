# ---------------------------------------------------------------------------
# Dawarly (FindIt) environment. Copy to .env.local and fill in real values.
# Never commit real credentials. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Public site URL (used in auth emails and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Dawarly

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Required for AI matching, email outbox, cron jobs, account
# deletion and the admin bootstrap CLI. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects /api/cron/* (Vercel Cron sends "Authorization: Bearer $CRON_SECRET").
# Use a random string of at least 16 characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=change-me-to-a-long-random-string

# Maps (OpenStreetMap tiles by default; respect the OSM tile usage policy or
# point this at your own/commercial tile server)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Fallback map centre "lat,lng" for universities without a configured centre
NEXT_PUBLIC_DEFAULT_MAP_CENTER=24.7136,46.6753

# ---------------------------------------------------------------------------
# AI (optional). Without these, the app uses bilingual non-AI matching and
# shows that AI is unavailable. Nothing is fabricated.
# ---------------------------------------------------------------------------
# Text embeddings via any OpenAI-compatible /embeddings endpoint: openai | none
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Image analysis: anthropic | openai | none
AI_VISION_PROVIDER=none
# Defaults: claude-opus-5-5 (anthropic) or gpt-4o-mini (openai)
AI_VISION_MODEL=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Email notifications (optional): resend | console | none
# "console" logs a redacted line instead of sending. In-app notifications
# always work regardless of email delivery.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Dawarly <no-reply@your-domain.example>"
